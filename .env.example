# Copy to .env to override the defaults used by docker-compose.yml.

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT=5432

# Database
DB_USERNAME=shopease
DB_PASSWORD=change-me

# Must be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

# Admin account created on first startup
ADMIN_EMAIL=admin@shopease.com
ADMIN_PASSWORD=change-me-too
